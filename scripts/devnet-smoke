#!/usr/bin/env python3
"""Manual devnet smoke test — proves the full execution path against
real Solana devnet.

WHAT IT DOES:
  1. Connects to https://api.devnet.solana.com (devnet-only client;
     refuses any other host).
  2. Loads the devnet keypair from the path in DEVNET_KEYPAIR_JSON
     (default: ~/.forex-agent/devnet/keypair.json).
  3. Verifies the on-chain address matches the expected pubkey.
  4. Reads the devnet SOL balance.
  5. Builds, signs, sends and confirms a tiny SELF-transfer
     (0.0001 SOL) — the same self-transfer the adapter performs per
     devnet fill.
  6. Prints the transaction signature + explorer link.

WHAT IT DOES NOT DO:
  - No memecoin swap (no DEX liquidity on devnet).
  - No mainnet anything (the client refuses non-devnet hosts).
  - Never prints the secret key.

REQUIREMENTS:
  - Network egress to api.devnet.solana.com (blocked from the Hatch
    sandbox VM as of 2026-09-22; run this from a machine with direct
    egress, e.g. the user's own machine or the future VPS).
  - The devnet keypair funded with a little devnet SOL
    (https://faucet.solana.com).

USAGE:
    DEVNET_KEYPAIR_JSON=~/.forex-agent/devnet/keypair.json \\
    DEVNET_EXPECTED_PUBKEY=5dqSy5pjEbM4yXpDahAhAzkcUn2g7rUnvPtTeUhbwvq1 \\
    python3 scripts/devnet-smoke
"""

import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(
    os.path.abspath(__file__))))

from broker.memecoin.execution.devnet_executor import DevnetExecutor
from broker.memecoin.execution import rpc as rpc_mod
from broker.memecoin.wallet import FileKeyProvider


def main() -> int:
    keypair_path = os.path.expanduser(os.environ.get(
        "DEVNET_KEYPAIR_JSON", "~/.forex-agent/devnet/keypair.json"))
    expected = os.environ.get("DEVNET_EXPECTED_PUBKEY", "").strip()

    provider = FileKeyProvider(keypair_path)
    ex = DevnetExecutor(key_provider=provider,
                        rpc_url=rpc_mod.DEFAULT_DEVNET_RPC,
                        expected_pubkey=expected)
    try:
        pubkey = ex.connect()
    except Exception as exc:
        print(f"connect failed: {exc}", file=sys.stderr)
        return 1

    print(f"connected: {pubkey}")
    balance = ex.balance_sol()
    print(f"devnet balance: {balance:.9f} SOL")
    if balance < 0.001:
        print("balance too low for smoke test — fund via "
              "https://faucet.solana.com", file=sys.stderr)
        return 1

    print("sending 0.0001 SOL self-transfer...")
    try:
        sig = ex.transfer_sol(pubkey, 0.0001)
    except Exception as exc:
        print(f"transfer failed: {exc}", file=sys.stderr)
        return 1

    print(f"confirmed signature: {sig}")
    print(f"explorer: https://explorer.solana.com/tx/{sig}?cluster=devnet")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
